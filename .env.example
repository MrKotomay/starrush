# ==================================
# StarRush environment example
# ==================================
# Copy to .env and replace all secrets before deploy.

# ---- Core app secrets ----
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=starrush_bot
SESSION_SECRET=replace_me_long_random_value
INTERNAL_API_KEY=replace_me_long_random_value
TELEGRAM_WEBHOOK_SECRET=replace_me_long_random_value
PAYMENTS_SIGNING_SECRET=replace_me_long_random_value
TONAPI_KEY=replace_me_tonapi_key
TON_DEPOSIT_ADDRESS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Runtime mode ----
NODE_ENV=production

# ---- Public domain / TLS ----
# Domain that points to your VDS public IP.
APP_DOMAIN=rush.example.com
# Email for Let's Encrypt account used by Caddy.
LETSENCRYPT_EMAIL=admin@example.com

# ---- Cookies ----
# Must be true in production (HTTPS).
COOKIE_SECURE=true
# Keep empty for single-domain setup.
# If needed, use ".example.com" to share across subdomains.
COOKIE_DOMAIN=

# ---- WebSocket public settings ----
# Leave empty to use same-host proxy "/ws" automatically.
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_GATEWAY_PORT=8081
NEXT_PUBLIC_GATEWAY_URL=

# ---- Database / Redis URLs for non-docker local runs ----
DATABASE_URL=postgresql://starrush:replace_me@localhost:5432/starrush
REDIS_URL=redis://localhost:6379

# ---- Local DB container credentials (used by compose service postgres) ----
POSTGRES_USER=starrush
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=starrush

# ---- Docker/VDS container connection overrides ----
# If empty, services use local compose postgres/redis automatically.
# Use these only when switching to external DBaaS.
DOCKER_DATABASE_URL=
DOCKER_REDIS_URL=
DOCKER_NEXT_PUBLIC_WS_URL=
DOCKER_NEXT_PUBLIC_GATEWAY_PORT=8081

# ---- Optional local host bindings for DB debug access on VDS ----
# Bound to 127.0.0.1 in docker-compose.yml.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---- Round loop settings ----
ROUND_GROWTH_RATE=0.15
ROUND_WAITING_MS=5000
ROUND_COOLDOWN_MS=3000
ROUND_TICK_MS=100
BET_SAFETY_WINDOW_MS=200

# ---- Bet limits ----
MAX_BET_TON=100
MAX_BET_STARS=1000

# ---- Economy / risk ----
GAME_HOUSE_EDGE=0.01
GAME_MAX_CRASH=1000
RISK_MAX_PAYOUT_FRACTION_PER_BET=0.02
RISK_MAX_EXPOSURE_FRACTION_PER_ROUND=0.10
HOUSE_BANKROLL_INITIAL_TON=0
HOUSE_BANKROLL_INITIAL_STARS=0
REFERRAL_DEPOSIT_RATE=0.10

# ---- Dev toggles (keep disabled in production) ----
DEV_AUTH_ENABLED=false
ENABLE_DEV_TREASURY=0
ENABLE_DEV_WALLET_ACTIONS=0

# ---- Payments toggles ----
ENABLE_STARS_PAYMENTS=0
ENABLE_TONCONNECT_DEPOSITS=0
ENABLE_GIFTS_STUB=0

# ---- Payments limits / policies ----
DEPOSIT_TTL_SECONDS=900
DEPOSIT_RATE_LIMIT_MAX=20
DEPOSIT_RATE_LIMIT_WINDOW_SECONDS=60
DEPOSIT_LIMITS_STARS_MIN=1
DEPOSIT_LIMITS_STARS_MAX=50000
DEPOSIT_LIMITS_TON_MIN=0.05
DEPOSIT_LIMITS_TON_MAX=500
TON_CONFIRMATIONS_REQUIRED=1

# Optional public override for TonConnect provider.
# NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://rush.example.com/api/tonconnect/manifest

# ---- Optional debug ----
# DEBUG_ROUND_LOOP=1
# APP_BASE_URL=https://rush.example.com
# WS_GATEWAY_URL=wss://rush.example.com/ws
# WS_TEST_COOKIE=
