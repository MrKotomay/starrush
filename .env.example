# =========================
# StarRush ENV (пример)
# =========================

# ---- База данных и Redis (обязательно) ----
# PostgreSQL URL (локально)
# Пример прод: postgresql://USER:PASS@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://starrush:starrush@localhost:5432/starrush
# Redis URL (локально)
REDIS_URL=redis://localhost:6379

# ---- Безопасность и сессии (обязательно) ----
# Токен бота Telegram Mini App
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=starrush_bot
# Секрет для подписи/хеширования сессий
SESSION_SECRET=replace_me
# Ключ для внутренних API (ledger/dev treasury)
INTERNAL_API_KEY=replace_me

# ---- Cookie (обязательно для прода, полезно локально) ----
# Для прод ставьте true (HTTPS)
COOKIE_SECURE=false
# Домен cookie (обычно пусто локально)
COOKIE_DOMAIN=

# ---- Публичный WS для фронта (обязательно) ----
# Явный URL websocket-шлюза для браузера
NEXT_PUBLIC_WS_URL=ws://localhost:8081
# Fallback порт, если NEXT_PUBLIC_WS_URL не задан
NEXT_PUBLIC_GATEWAY_PORT=8081
# Legacy fallback URL (опционально, можно оставить пустым)
NEXT_PUBLIC_GATEWAY_URL=

# ---- Параметры раунда/игры (обязательно) ----
ROUND_GROWTH_RATE=0.15
ROUND_WAITING_MS=5000
ROUND_COOLDOWN_MS=3000
ROUND_TICK_MS=100
BET_SAFETY_WINDOW_MS=200

# ---- Лимиты ставок (обязательно) ----
MAX_BET_TON=100
MAX_BET_STARS=1000

# ---- Экономика и риск (обязательно) ----
GAME_HOUSE_EDGE=0.01
GAME_MAX_CRASH=1000
RISK_MAX_PAYOUT_FRACTION_PER_BET=0.02
RISK_MAX_EXPOSURE_FRACTION_PER_ROUND=0.10
HOUSE_BANKROLL_INITIAL_TON=0
HOUSE_BANKROLL_INITIAL_STARS=0
REFERRAL_DEPOSIT_RATE=0.10

# ---- Dev переключатели (опционально) ----
# Если не задано: fallback на NODE_ENV (development => включен dev auth)
# Можно задавать: true/false или 1/0
DEV_AUTH_ENABLED=false
# Dev-API пополнения казны
ENABLE_DEV_TREASURY=0
# Dev-API депозит/вывод кошелька
ENABLE_DEV_WALLET_ACTIONS=0

# ---- Опциональные переменные (обычно не нужны) ----
# Порт websocket gateway backend (по умолчанию 8081)
# GATEWAY_PORT=8081
# Base URL для scripts/dev_house_fund.ts
# APP_BASE_URL=http://localhost:3000
# Подробные логи round loop worker/service
# DEBUG_ROUND_LOOP=0
# Для scripts/ws_gateway_smoke.ts
# WS_GATEWAY_URL=ws://localhost:8081
# WS_TEST_COOKIE=
