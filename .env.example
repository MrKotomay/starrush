# ============================================================================
# StarRush .env.example (ПРОД / ТОЛЬКО DBaaS)
# ============================================================================
# Шаблон для прод-развертывания с внешними PostgreSQL и Redis.
# Обязательно: перед деплоем замените все значения replace_me.

# ---------------------------------------------------------------------------
# 1) Режим запуска
# ---------------------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------------------
# 2) Домен / TLS (Caddy)
# ---------------------------------------------------------------------------
APP_DOMAIN=replace_me
LETSENCRYPT_EMAIL=replace_me

# ---------------------------------------------------------------------------
# 3) Авторизация / безопасность
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=replace_me
# Случайный длинный секрет для подписанных сессий/cookies (обязательно).
# Пример генерации:
# openssl rand -hex 32
SESSION_SECRET=replace_me
INTERNAL_API_KEY=replace_me
ADMIN_TELEGRAM_IDS=replace_me
# Telegram Web Login client id from BotFather -> Bot Settings -> Web Login
TELEGRAM_LOGIN_CLIENT_ID=
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_HASH=$2a$10$qt8PTzzd9NureQORWClDhOppvqGk334gNw0qWYEsrXnMuqjJUx8Pm
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# 4) Фронтенд / WebSocket
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_GATEWAY_PORT=8081
NEXT_PUBLIC_GATEWAY_URL=
ALLOWED_WS_ORIGINS=https://your-domain.com
MAX_WS_CONNECTIONS_PER_USER=5
# Optional override if TON Connect should fetch manifest from a public URL directly.
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=
NEXT_PUBLIC_TONCONNECT_WALLETS_LIST_URL=
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=0
APP_INTERNAL_BASE_URL=http://app:3000
APP_BASE_URL=https://your-domain.com
GATEWAY_INTERNAL_BASE_URL=http://gateway:8081
WORKER_INTERNAL_BASE_URL=http://worker:8082
ADMIN_STUDIO_DATABASE_URL=

# ---------------------------------------------------------------------------
# 5) URL подключения к DBaaS (обязательно для docker-compose.yml)
# ---------------------------------------------------------------------------
# Timeweb обычно показывает поля отдельно:
# host, port, dbname, user, password.
# Этот проект использует ОДНУ URL-строку для PostgreSQL и ОДНУ для Redis.
#
# Формат PostgreSQL URL:
# postgresql://<user>:<urlencoded_password>@<host>:<port>/<dbname>?schema=public&sslmode=require
#
# - schema=public: стандартная схема Prisma в Postgres.
# - sslmode=require: включить TLS. Если ваш private-IP endpoint БЕЗ TLS,
#   замените на sslmode=disable.
#
# Формат Redis URL:
# redis://<user>:<urlencoded_password>@<host>:<port>
# - используйте rediss://... только если провайдер явно требует TLS для Redis.
#
# ВАЖНО: если в пароле есть спецсимволы (@ : / ? # & %), сначала сделайте URL-encoding.
DOCKER_DATABASE_URL=postgresql://replace_me_user:replace_me_pass@replace_me_host:5432/replace_me_db?schema=public&sslmode=require
DOCKER_REDIS_URL=redis://default:replace_me_pass@replace_me_host:6379

# Необязательные переменные для build
DOCKER_NEXT_PUBLIC_WS_URL=
DOCKER_NEXT_PUBLIC_GATEWAY_PORT=8081

# Необязательные URL для локального запуска без Docker
DATABASE_URL=postgresql://replace_me_user:replace_me_pass@localhost:5432/replace_me_db?schema=public
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# 6) Платежи (Stars / TON)
# ---------------------------------------------------------------------------
ENABLE_STARS_PAYMENTS=1
ENABLE_TONCONNECT_DEPOSITS=1
ENABLE_GIFTS_STUB=1

PAYMENTS_SIGNING_SECRET=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_me

TONAPI_KEY=replace_me
TON_DEPOSIT_ADDRESS=replace_me
TON_CONFIRMATIONS_REQUIRED=1

DEPOSIT_TTL_SECONDS=900
DEPOSIT_RATE_LIMIT_MAX=20
DEPOSIT_RATE_LIMIT_WINDOW_SECONDS=60
DEPOSIT_LIMITS_STARS_MIN=1
DEPOSIT_LIMITS_STARS_MAX=50000
DEPOSIT_LIMITS_TON_MIN=0.05
DEPOSIT_LIMITS_TON_MAX=500

# ---------------------------------------------------------------------------
# 7) Игровой цикл / лимиты
# ---------------------------------------------------------------------------
BET_SAFETY_WINDOW_MS=200
ROUND_COOLDOWN_MS=3000
ROUND_GROWTH_RATE=0.09
# 0.09 ~= 2x around 7.7s
ROUND_TICK_MS=100
ROUND_MULTIPLIER_BROADCAST_MS=200
ROUND_WAITING_MS=5000

MAX_BET_STARS=1000
MAX_BET_TON=100

# ---------------------------------------------------------------------------
# 8) Экономика / риск
# ---------------------------------------------------------------------------
GAME_HOUSE_EDGE=0.01
GAME_MAX_CRASH=1000
HOUSE_BANKROLL_INITIAL_STARS=0
HOUSE_BANKROLL_INITIAL_TON=0
REFERRAL_DEPOSIT_RATE=0.10
RISK_MAX_EXPOSURE_FRACTION_PER_ROUND=0.10
RISK_MAX_PAYOUT_FRACTION_PER_BET=0.02

# ---------------------------------------------------------------------------
# 9) Dev-флаги (в проде должны быть выключены)
# ---------------------------------------------------------------------------
DEV_AUTH_ENABLED=false
ENABLE_DEV_TREASURY=0
ENABLE_DEV_WALLET_ACTIONS=0

# ---------------------------------------------------------------------------
# 10) Необязательная отладка
# ---------------------------------------------------------------------------
# DEBUG_ROUND_LOOP=1
# WS_GATEWAY_URL=wss://your-domain.com/ws
# REDIS_LAZY_CONNECT=1
# WORKER_HEALTH_PORT=8082
# TONCONNECT_WALLETS_LIST_SOURCES=https://config.ton.org/wallets-v2.json,https://raw.githubusercontent.com/ton-connect/wallets-list/main/wallets-v2.json
# WS_TEST_COOKIE=
# GATEWAY_PORT=8081
# PORT=3000
