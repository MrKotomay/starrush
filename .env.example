# ============================================================================
# StarRush - production .env / .env.example (единый шаблон)
# ============================================================================
# Этот файл покрывает запуск полного стека в Docker Compose:
# app + gateway + worker + postgres + redis + caddy(SSL)
#
# Что обязательно заменить перед боем:
# - все значения replace_me
# - APP_DOMAIN
# - LETSENCRYPT_EMAIL
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Базовый режим приложения
# ---------------------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------------------
# 2) Домен и SSL (Caddy + Let's Encrypt)
# ---------------------------------------------------------------------------
# Домен с A-записью на IP сервера.
APP_DOMAIN=replace_me
# Почта для регистрации/уведомлений Let's Encrypt.
LETSENCRYPT_EMAIL=replace_me

# ---------------------------------------------------------------------------
# 3) Telegram, сессии и внутренние ключи
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=replace_me
SESSION_SECRET=replace_me
INTERNAL_API_KEY=replace_me

# ---------------------------------------------------------------------------
# 4) Cookie/сессии
# ---------------------------------------------------------------------------
# В production при HTTPS должно быть true.
COOKIE_SECURE=true
# Для одного домена оставь пустым.
# Для поддоменов можно указать: .example.com
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# 5) Публичные настройки фронтенда/WS
# ---------------------------------------------------------------------------
# Оставь пустым для same-host прокси: wss://<домен>/ws
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_GATEWAY_PORT=8081
NEXT_PUBLIC_GATEWAY_URL=
# Обычно не требуется. Если пусто - используется /api/tonconnect/manifest
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=

# ---------------------------------------------------------------------------
# 6) БД и Redis (локальный запуск без Docker)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://starrush:replace_me@localhost:5432/starrush
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# 7) Настройки встроенных postgres/redis контейнеров
# ---------------------------------------------------------------------------
POSTGRES_USER=starrush
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=starrush
# Локальный bind только на сервере (127.0.0.1).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---------------------------------------------------------------------------
# 8) Docker/VDS override переменные
# ---------------------------------------------------------------------------
# Оставь пустыми, если используешь локальные compose postgres/redis.
DOCKER_DATABASE_URL=
DOCKER_REDIS_URL=
# Build-override для фронта (обычно не требуется менять).
DOCKER_NEXT_PUBLIC_WS_URL=
DOCKER_NEXT_PUBLIC_GATEWAY_PORT=8081

# ---------------------------------------------------------------------------
# 9) Боевые пополнения: Telegram Stars / TON Connect
# ---------------------------------------------------------------------------
# Включение прод-рельс пополнений.
ENABLE_STARS_PAYMENTS=1
ENABLE_TONCONNECT_DEPOSITS=1
# Технический stub для gifts (на экономику не влияет).
ENABLE_GIFTS_STUB=1

# Секрет подписи invoice payload для Stars.
PAYMENTS_SIGNING_SECRET=replace_me
# Должен совпадать с secret_token из setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace_me

# TON верификация (TONAPI + депозитный адрес проекта).
TONAPI_KEY=replace_me
TON_DEPOSIT_ADDRESS=replace_me
TON_CONFIRMATIONS_REQUIRED=1

# TTL / rate-limit / лимиты депозитов.
DEPOSIT_TTL_SECONDS=900
DEPOSIT_RATE_LIMIT_MAX=20
DEPOSIT_RATE_LIMIT_WINDOW_SECONDS=60
DEPOSIT_LIMITS_STARS_MIN=1
DEPOSIT_LIMITS_STARS_MAX=50000
DEPOSIT_LIMITS_TON_MIN=0.05
DEPOSIT_LIMITS_TON_MAX=500

# ---------------------------------------------------------------------------
# 10) Игровой цикл
# ---------------------------------------------------------------------------
BET_SAFETY_WINDOW_MS=200
ROUND_COOLDOWN_MS=3000
ROUND_GROWTH_RATE=0.15
ROUND_TICK_MS=100
ROUND_WAITING_MS=5000

# ---------------------------------------------------------------------------
# 11) Лимиты ставок
# ---------------------------------------------------------------------------
MAX_BET_STARS=1000
MAX_BET_TON=100

# ---------------------------------------------------------------------------
# 12) Экономика и риск
# ---------------------------------------------------------------------------
GAME_HOUSE_EDGE=0.01
GAME_MAX_CRASH=1000
HOUSE_BANKROLL_INITIAL_STARS=0
HOUSE_BANKROLL_INITIAL_TON=0
REFERRAL_DEPOSIT_RATE=0.10
RISK_MAX_EXPOSURE_FRACTION_PER_ROUND=0.10
RISK_MAX_PAYOUT_FRACTION_PER_BET=0.02

# ---------------------------------------------------------------------------
# 13) Dev-тумблеры (в production обычно выключены)
# ---------------------------------------------------------------------------
DEV_AUTH_ENABLED=false
ENABLE_DEV_TREASURY=0
ENABLE_DEV_WALLET_ACTIONS=0

# ---------------------------------------------------------------------------
# 14) Опциональные debug/ручной запуск
# ---------------------------------------------------------------------------
# DEBUG_ROUND_LOOP=1
# APP_BASE_URL=https://your-domain.com
# WS_GATEWAY_URL=wss://your-domain.com/ws
# WS_TEST_COOKIE=
# GATEWAY_PORT=8081
# PORT=3000