{
  email {$LETSENCRYPT_EMAIL:admin@example.com}
}

{$APP_DOMAIN:localhost} {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  @internal_api {
    path /api/ledger/internal/*
    path /api/payments/ton/reconcile
    path /api/dev/*
  }
  respond @internal_api 404

  @admin path /admin /admin/* /api/admin /api/admin/*
  handle @admin {
    basic_auth {
      {$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
    }

    reverse_proxy app:3000
  }

  @gateway_ws path /ws*
  reverse_proxy @gateway_ws gateway:8081

  reverse_proxy app:3000
}
