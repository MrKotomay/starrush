generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  telegramId        BigInt             @unique
  username          String?            @db.VarChar(64)
  firstName         String?            @db.VarChar(128)
  lastName          String?            @db.VarChar(128)
  photoUrl          String?            @db.VarChar(512)
  languageCode      String?            @db.VarChar(16)
  isBot             Boolean            @default(false)
  referredById      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  wallets           Wallet[]
  ledger            LedgerEntry[]
  depositIntents    DepositIntent[]
  giftIngressEvents GiftIngressEvent[]
  giftStubs         UserGiftStub[]
  roundPlayers      RoundPlayer[]
  queuedRoundBet    RoundQueuedBet?
  adminAuditLogs    AdminAuditLog[]
  referredBy        User?              @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]             @relation("UserReferrals")

  @@index([createdAt])
  @@index([referredById])
}

enum Currency {
  TON
  STARS
}

enum DepositProvider {
  TELEGRAM_STARS
  TON_CONNECT
}

enum DepositStatus {
  CREATED
  WAITING_PAYMENT
  SUBMITTED
  CONFIRMING
  COMPLETED
  FAILED
  EXPIRED
  CANCELED
}

enum LedgerType {
  DEPOSIT
  WITHDRAW
  REWARD
  PURCHASE
  BET_LOCK
  BET_LOSS_SETTLEMENT
  BET_WIN
  GAME_BET
  GAME_WIN
  ADJUSTMENT
  TRANSFER
}

enum LedgerStatus {
  PENDING
  COMPLETED
  FAILED
}

enum HouseLedgerType {
  INITIAL_BANKROLL
  BET_LOSS_SETTLEMENT
  BET_WIN
  HOUSE_FUND
  ADJUSTMENT
}

enum RoundStatus {
  WAITING
  RUNNING
  CRASHED
  FINISHED
}

enum FairnessVersion {
  LEGACY_HASH_V0
  HMAC_SHA256_V1
  HMAC_SHA256_V2_BOUNDED_MAX
}

enum RoundPlayerStatus {
  BET_PLACED
  CASHED_OUT
  LOST
}

enum RoundEventType {
  ROUND_WAITING
  ROUND_STARTED
  MULTIPLIER_UPDATE
  PLAYER_BET
  PLAYER_CASHOUT
  ROUND_CRASHED
  ROUND_FINISHED
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(128)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String
  currency      Currency
  balance       Decimal  @default(0) @db.Decimal(20, 9)
  lockedBalance Decimal  @default(0) @db.Decimal(20, 9)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id])
  ledger LedgerEntry[]

  @@unique([userId, currency])
  @@index([currency])
}

model LedgerEntry {
  id          String       @id @default(cuid())
  userId      String
  walletId    String
  currency    Currency
  amount      Decimal      @db.Decimal(20, 9)
  type        LedgerType
  status      LedgerStatus @default(PENDING)
  referenceId String       @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime     @default(now())

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([walletId, referenceId, type])
  @@index([userId, currency, createdAt])
  @@index([walletId, createdAt])
  @@index([referenceId])
}

model HouseWallet {
  id        String             @id @default(cuid())
  currency  Currency           @unique
  balance   Decimal            @default(0) @db.Decimal(20, 9)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  ledger    HouseLedgerEntry[]

  @@index([currency])
}

model HouseLedgerEntry {
  id            String          @id @default(cuid())
  houseWalletId String
  currency      Currency
  amount        Decimal         @db.Decimal(20, 9)
  type          HouseLedgerType
  roundId       String?
  userId        String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  houseWallet HouseWallet @relation(fields: [houseWalletId], references: [id])

  @@unique([houseWalletId, roundId, userId, type])
  @@index([currency, createdAt])
  @@index([houseWalletId, createdAt])
  @@index([roundId, createdAt])
  @@index([userId, createdAt])
}

model Round {
  id              String          @id @default(cuid())
  status          RoundStatus     @default(WAITING)
  fairnessVersion FairnessVersion @default(HMAC_SHA256_V1)
  fairnessNonce   Int             @default(0)
  clientSeed      String?         @db.VarChar(128)
  serverSeedHash  String          @db.VarChar(128)
  serverSeed      String?         @db.VarChar(128)
  houseEdge       Decimal         @default(0.01) @db.Decimal(10, 6)
  maxCrash        Decimal         @default(1000) @db.Decimal(20, 6)
  crashMultiplier Decimal?        @db.Decimal(20, 6)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())

  players RoundPlayer[]
  events  RoundEventLog[]

  @@index([status, createdAt])
}

model RoundPlayer {
  id                String            @id @default(cuid())
  roundId           String
  userId            String
  currency          Currency
  betAmount         Decimal           @db.Decimal(20, 9)
  cashoutMultiplier Decimal?          @db.Decimal(20, 6)
  profit            Decimal?          @db.Decimal(20, 9)
  status            RoundPlayerStatus @default(BET_PLACED)
  createdAt         DateTime          @default(now())

  round Round @relation(fields: [roundId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([roundId, userId])
  @@index([createdAt])
  @@index([roundId, status])
  @@index([roundId, currency, status])
  @@index([userId])
}

model RoundQueuedBet {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  Currency
  betAmount Decimal  @db.Decimal(20, 9)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([currency, createdAt])
}

model RoundEventLog {
  id        String         @id @default(cuid())
  roundId   String
  eventType RoundEventType
  payload   Json
  createdAt DateTime       @default(now())

  round Round @relation(fields: [roundId], references: [id])

  @@index([roundId, createdAt])
}

model DepositIntent {
  id                 String          @id @default(cuid())
  userId             String
  provider           DepositProvider
  currency           Currency
  status             DepositStatus   @default(CREATED)
  amount             Decimal         @db.Decimal(20, 9)
  amountNano         BigInt?
  senderAddress      String?         @db.VarChar(128)
  recipientAddress   String?         @db.VarChar(128)
  providerPaymentId  String?         @db.VarChar(256)
  providerExternalId String?         @db.VarChar(256)
  providerPayload    String?         @db.VarChar(256)
  txHash             String?         @db.VarChar(256)
  txBoc              String?
  ledgerReferenceId  String          @db.VarChar(128)
  failureReason      String?         @db.VarChar(256)
  metadata           Json?
  expiresAt          DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user   User                   @relation(fields: [userId], references: [id])
  events PaymentProviderEvent[]

  @@unique([ledgerReferenceId])
  @@unique([provider, providerPaymentId])
  @@unique([provider, txHash])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
}

model PaymentProviderEvent {
  id          String          @id @default(cuid())
  provider    DepositProvider
  eventId     String          @db.VarChar(128)
  eventType   String          @db.VarChar(64)
  intentId    String?
  status      String          @default("RECEIVED") @db.VarChar(32)
  error       String?         @db.VarChar(256)
  payload     Json
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  intent DepositIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([provider, eventType, createdAt])
  @@index([intentId, createdAt])
}

model GiftIngressEvent {
  id              String   @id @default(cuid())
  providerEventId String?  @unique @db.VarChar(128)
  telegramGiftId  String?  @db.VarChar(128)
  fromTelegramId  BigInt?
  toTelegramId    BigInt?
  userId          String?
  payload         Json
  createdAt       DateTime @default(now())

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  giftStubs UserGiftStub[]

  @@index([userId, createdAt])
  @@index([telegramGiftId, createdAt])
}

model UserGiftStub {
  id                 String   @id @default(cuid())
  userId             String
  giftIngressEventId String
  giftType           String   @db.VarChar(128)
  quantity           Int      @default(1)
  metadata           Json?
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  giftIngressEvent GiftIngressEvent @relation(fields: [giftIngressEventId], references: [id], onDelete: Cascade)

  @@unique([userId, giftIngressEventId, giftType])
  @@index([userId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorUserId String
  action     String   @db.VarChar(64)
  targetType String?  @db.VarChar(64)
  targetId   String?  @db.VarChar(128)
  requestId  String?  @unique @db.VarChar(128)
  ip         String?  @db.VarChar(128)
  userAgent  String?  @db.VarChar(512)
  metadata   Json?
  createdAt  DateTime @default(now())

  actorUser User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}
